# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 to force the deterministic offline mode (no LLM calls) - useful for demos/tests
HACKAGENT_OFFLINE=0

# --- Optional web research ---
TAVILY_API_KEY=

# --- Tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=hackagent

# --- Budgets ---
MAX_ITERATIONS=25
MAX_DEBUG_LOOPS=4
MAX_WALL_MINUTES=20
MAX_TOKENS_BUDGET=400000
CMD_TIMEOUT_SECONDS=600

# --- Memory ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_PERSONA=karpathy-zero-to-hero
